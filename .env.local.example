# Any OpenAI-compatible endpoint. Copy this file to .env.local, pick ONE block
# below, then restart the dev server (Next.js reads .env.local only at boot).

# ---- OpenRouter — open-weight models, hosted. Roughly $0.001–0.003 per essay.
# Key: https://openrouter.ai/keys   Model list: https://openrouter.ai/models
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=deepseek/deepseek-chat

# ---- Groq — free tier, open-weight models, very fast.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# ---- Ollama — fully local, £0, no key. `ollama pull qwen2.5:14b` first.
# On a 16 GB M2, 14B is about the largest that runs comfortably.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b

# ---- LM Studio — fully local, £0, no key.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen2.5-14b-instruct
